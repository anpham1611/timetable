# Admin login credentials gating all admin routes (/api/admin/*). An admin logs
# in with these at the login page; the API then issues a session token used to
# authorize admin requests. When either is unset, login fails and every admin
# request is rejected (fail closed). These stay on the server and are never
# shipped to the browser.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-dev-secret

# Database engine. Leave as "sqlite" for local development (data stored in a
# local file). Set to "turso" in production / on serverless hosts like Vercel,
# where the filesystem is ephemeral and a hosted database is required.
DB_ENGINE=sqlite

# --- sqlite engine (DB_ENGINE=sqlite) ---
# Optional: SQLite database file path (defaults to timetable.sqlite).
# Accepts a bare path or a libSQL "file:" URL.
# DATABASE_URL=timetable.sqlite

# --- turso engine (DB_ENGINE=turso) ---
# Required when DB_ENGINE=turso. Get these from the Turso dashboard or the
# Vercel + Turso integration (which injects them automatically).
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Optional: API port (defaults to 3000).
# PORT=3000
