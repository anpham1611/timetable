# Admin login credentials gating all admin routes (/api/admin/*). An admin logs
# in with these at the login page; the API then issues a session token used to
# authorize admin requests. When either is unset, login fails and every admin
# request is rejected (fail closed). These stay on the server and are never
# shipped to the browser.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-dev-secret

# Optional: SQLite database file path (defaults to timetable.sqlite).
# DATABASE_URL=timetable.sqlite

# Optional: API port (defaults to 3000).
# PORT=3000
